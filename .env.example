# Copia questo file in ".env" e modificalo:  cp .env.example .env

# OBBLIGATORIA: password per entrare nella dashboard (scegline una lunga: è l'unica protezione oltre a Tailscale).
# Se la lasci vuota o con un valore d'esempio, ne viene generata una temporanea e scritta nei log
# (docker compose logs pi-dashboard), diversa a ogni avvio.
DASH_PASSWORD=

# Porta su cui risponde la dashboard
PORT=8080

# ACCESSO: da dove si può aprire la dashboard. Predefinito: rete locale (LAN) e Tailscale, mai da Internet.
#   BIND_ADDRESS: su quali interfacce il Pi ascolta
#     all        = tutte (LAN e Tailscale)                       <- predefinito
#     tailscale  = solo l'IP Tailscale del Pi (richiede Tailscale attivo sul Pi)
#     127.0.0.1  = solo il Pi stesso, da usare con "tailscale serve" per avere HTTPS
BIND_ADDRESS=all
TAILSCALE_INTERFACE=tailscale0
#   ALLOWED_NETWORKS: da quali indirizzi accetta le richieste. Nomi e/o reti CIDR separati da virgola:
#     tailscale = reti Tailscale     lan = reti private (192.168.x.x, 10.x.x.x, 172.16-31.x.x)     loopback = il Pi stesso
#     Solo Tailscale:  ALLOWED_NETWORKS=tailscale,loopback  (e BIND_ADDRESS=tailscale)
#     Solo la tua LAN: ALLOWED_NETWORKS=192.168.1.0/24,loopback
#     any = nessun filtro (sconsigliato)
ALLOWED_NETWORKS=tailscale,lan,loopback

# Giorni di storico da conservare nel database
RETENTION_DAYS=30

# Imposta a true solo se metti la dashboard dietro HTTPS (reverse proxy)
COOKIE_SECURE=false

# Avvisi Telegram (facoltativi): crea un bot con @BotFather e ricava il chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook per gli avvisi (facoltativo): ntfy, Discord, Slack, Home Assistant...
#   WEBHOOK_FORMAT=json  invia {"level","kind","message","ts","text","content"}
#   WEBHOOK_FORMAT=text  invia il solo testo (adatto a ntfy: https://ntfy.sh/il-tuo-topic)
WEBHOOK_URL=
WEBHOOK_FORMAT=json

# Pagina di stato di sola lettura su /status, senza login, con i controlli del Monitor marcati "pubblici".
# Resta comunque dietro Tailscale (o al filtro ALLOWED_NETWORKS).
STATUS_PAGE=false
STATUS_TITLE=Stato dei servizi

# Interruttori (true/false)
DOCKER_ENABLED=true
POWER_ENABLED=true
